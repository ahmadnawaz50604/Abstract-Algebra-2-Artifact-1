# GEMINI_API_KEY: Required for Gemini AI Tutor API calls.
# Configure this in AI Studio Secrets or Vercel Project Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Recommended (16+ random characters) for persistent HMAC session cookies on Vercel/production.
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
